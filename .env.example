# bigpictures.company environment variables
#
# Copy to `.env` for local dev. Loaded by the Go CLI via caarlos/env.
# The Next.js app reads `DATABASE_URL` + `TILE_BASE_URL` from its own .env.

# --- Cloudflare R2 ---
PANO_R2_ACCOUNT_ID=
PANO_R2_ACCESS_KEY_ID=
PANO_R2_SECRET_ACCESS_KEY=
PANO_R2_BUCKET=bigpictures

# Public base URL for the R2 bucket via custom domain.
# Tiles, thumbnails, and info.json are served from here.
PANO_TILE_BASE_URL=https://tiles.bigpictures.company

# --- Neon Postgres ---
#
# Use the DIRECT URL for the CLI (migrations + queries).
# The Next.js app uses the POOLER URL — they are different connection strings.
PANO_DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require

# --- Optional ---
# Override where intermediate tile pyramids are written.
# Defaults to $TMPDIR/pano-<slug>-<rand>.
# PANO_TMP_DIR=

# vips concurrency. Leave unset to use the default (NCPU); lower it if
# tiling is starving the upload stage.
# VIPS_CONCURRENCY=4
